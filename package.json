{
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node dev-tools/buildScripts/validate-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:release": "python -B -m unittest tests.test_build_release -v",
    "build:release": "python -B dev-tools/buildScripts/build_release.py",
    "build:banner": "python -B dev-tools/buildScripts/generate_foundry_banner.py --output-dir dist"
  }
}
