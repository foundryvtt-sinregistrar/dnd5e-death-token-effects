# Normalize text files to LF in Git.
* text=auto
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Exclude development-only files from git-archive release packages.
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
.github/ export-ignore
.idea/ export-ignore
.vscode/ export-ignore
dev-tools/ export-ignore
docs/foundry/ export-ignore
tests/ export-ignore
dist/ export-ignore
tmp/ export-ignore
_release-zip/ export-ignore
.venv/ export-ignore
node_modules/ export-ignore
__pycache__/ export-ignore
.history/ export-ignore
.ionide/ export-ignore
.env export-ignore
.env.* export-ignore
APPLY.md export-ignore
DEVELOPER.md export-ignore
staged.txt export-ignore
